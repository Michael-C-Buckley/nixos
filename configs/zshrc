[[ -o interactive ]] || return

bindkey -e
setopt AUTO_LIST
setopt COMPLETE_IN_WORD
setopt CORRECT
setopt EXTENDED_GLOB

export NH_OS_FLAKE="$HOME/.config/nixos"

# Starship replaces this when available. Keep a usable prompt when the command
# is absent because a Nix or Homebrew profile was not loaded.
PROMPT='%F{cyan}%~%f %# '

# Command shortcuts.
alias nv='nvim'
alias b='brew'
alias g='git'
alias ga='git add '
alias gaa='git add .'
alias gad='git add'
alias gb='git branch'
alias gc='git commit'
alias gcm='git commit -m'
alias gco='git checkout'
alias gd='git diff'
alias gd='git diff --staged'
alias gdc='git diff --cached'
alias gf='git fetch'
alias gm='git merge'
alias gp='git pull'
alias gP='git push'
alias gpoh='git push origin HEAD'
alias gr='git restore'
alias gredo='git commit --amend -S'
alias gs='git status'
alias k='kubectl'

if (( $+commands[eza] )); then
	alias ls='eza --group-directories-first'
	alias ll='eza -lah --git --icons --group-directories-first'
	alias la='eza -la --group-directories-first'
fi

setopt APPEND_HISTORY
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE

HISTFILE=$ZDOTDIR/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
HISTORY_IGNORE='(ls|ls *)'

# Install zcomet on first use.
_zcomet_dir="${ZDOTDIR:-$HOME}/.zcomet/bin"
if [[ ! -r "$_zcomet_dir/zcomet.zsh" ]]; then
    command git clone https://github.com/agkozak/zcomet.git "$_zcomet_dir" || return
fi
source "$_zcomet_dir/zcomet.zsh"
unset _zcomet_dir

zmodload zsh/complist
bindkey -M menuselect 'h' vi-backward-char
bindkey -M menuselect 'k' vi-up-line-or-history
bindkey -M menuselect 'j' vi-down-line-or-history
bindkey -M menuselect 'l' vi-forward-char

# Keep a separate dump because the system zshrc also runs compinit.
zstyle ':zcomet:compinit' dump-file "${ZDOTDIR:-$HOME}/.zcompdump-user"
zcomet compinit

zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/.zcompcache"
zstyle ':completion:*:squeeze-slashes' true
zstyle ':completion:*:*:-command-:*:*' group-order alias builtins functions commands
zstyle ':completion:*:file-list' all
zstyle ':completion:*:group-name' ''
zstyle ':completion:*:*:*:*:descriptions' format '%F{green}--> %d%f'
zstyle ':completion:*:warnings' format ' %F{red}!-> no matches found%f'
zstyle ':completion:*:messages' format ' %F{purple}--> %d%f'
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*:*:*:*:corrections' format '%F{yellow}!-> %d (errors: %e)%f'
zstyle ':completion:*' completer _complete _approximate
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'

# fzf's native integration supplies Ctrl-R history, Ctrl-T files, Alt-C
# directories, and fuzzy completion. All dependencies are optional.
if (( $+commands[fzf] )); then
	export FZF_DEFAULT_OPTS='--height=60% --layout=reverse --border'

	if (( $+commands[fd] )); then
		export FZF_CTRL_T_COMMAND='fd --type f --hidden --follow --exclude .git'
		export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
	fi

	if (( $+commands[bat] )); then
		export FZF_CTRL_T_OPTS="
			--preview 'bat --color=always --style=numbers --line-range=:500 -- {} 2>/dev/null'
			--preview-window 'right:60%:wrap'
		"
	fi

	source <(fzf --zsh 2>/dev/null)
fi

# fzf-tab must load after compinit and fzf, but before autosuggestions.
if (( $+commands[fzf] )); then
    zcomet load Aloxaf/fzf-tab
    zstyle ':fzf-tab:*' fzf-flags --height=60% --layout=reverse --border
    zstyle ':fzf-tab:*' switch-group '<' '>'
fi

# Use command-aware completion when a command is present; otherwise retain
# Ctrl-T's generic file picker.
_fzf_context_widget() {
	if [[ -n "${LBUFFER//[[:space:]]/}" ]] &&
	   (( $+widgets[fzf-tab-complete] )); then
		zle fzf-tab-complete
	elif (( $+widgets[fzf-file-widget] )); then
		zle fzf-file-widget
	else
		zle redisplay
	fi
}

if (( $+widgets[fzf-tab-complete] || $+widgets[fzf-file-widget] )); then
	zle -N _fzf_context_widget
	bindkey '^T' _fzf_context_widget
fi

ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
zcomet load zsh-users/zsh-autosuggestions

if (( $+commands[zoxide] )); then
	eval "$(zoxide init zsh --cmd z 2>/dev/null)"
fi

if (( $+commands[direnv] )); then
	eval "$(direnv hook zsh 2>/dev/null)"
fi

if (( $+commands[starship] )); then
	if [[ -r "$HOME/.config/starship/config.toml" ]]; then
		export STARSHIP_CONFIG="$HOME/.config/starship/config.toml"
	fi
	eval "$(starship init zsh 2>/dev/null)"
fi

if [[ "${STARSHIP_SHELL:-}" == zsh ]]; then
    TRANSIENT_PROMPT_PROMPT=$PROMPT
    TRANSIENT_PROMPT_RPROMPT=$RPROMPT
    TRANSIENT_PROMPT_TRANSIENT_PROMPT='%F{8}❯%f '
    TRANSIENT_PROMPT_TRANSIENT_RPROMPT=''
    zcomet load olets/zsh-transient-prompt transient-prompt.zsh-theme
fi

killdns() {
	sudo dscacheutil -flushcache
	sudo killall -HUP mDNSResponder
}

zcomet load zdharma-continuum/fast-syntax-highlighting

unfunction _zsh_find_plugin_file
unset _zsh_brew_prefix
unset _zsh_plugin_share_roots
unset _zsh_fzf_tab_file
unset _zsh_autosuggestions_file
unset _zsh_transient_prompt_file
unset _zsh_syntax_highlighting_file
