# Drop duplicate PATH entries from repeated prepends and nested shells. Both
# names are needed: -U on `path` alone ignores `PATH=...` assignments.
typeset -U path PATH

export ZDOTDIR="${XDG_CONFIG_HOME:-$HOME/.config}/zsh"
export EDITOR="nvim"
export VISUAL="$EDITOR"
export PATH="$HOME/.local/bin:$PATH"

# Use my custom agent socket for mac
if [[ "$OSTYPE" == darwin* ]]; then
    export SSH_AUTH_SOCK="$HOME/.ssh/agent/openssh.sock"
fi

# Ensure that nix gets sourced
if [[ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]] &&
   (( ! $+commands[nix] )); then
  unset __ETC_PROFILE_NIX_SOURCED
  source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi
