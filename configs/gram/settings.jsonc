{
  "restore_on_startup": "empty_tab",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "tabs": { "file_icons": true, "git_status": true, "show_diagnostics": "all" },
  "toolbar": { "code_actions": true },
  "diagnostics": { "inline": { "enabled": true, "min_column": 80 } },
  "git": { "git_gutter": "tracked_files" },
  "icon_theme": {
    "mode": "system",
    "light": "Gram (Default)",
    "dark": "Gram (Default)"
  },
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Oasis Midnight Dark"
  },

  "languages": {
    "YAML": {
      "format_on_save": "off"
    },
    "JSON": {
      "formatter": {
        "external": {
          "arguments": ["format", "--stdin-file-path", "{buffer_path}"],
          "command": "biome"
        }
      }
    },
    "Nix": {
      "language_servers": ["nil"]
    }
  }
}
