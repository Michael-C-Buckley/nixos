[branch]
	sort = -committerdate

[column]
	ui = auto

[commit]
	gpgSign = true
	verbose = true

[credential]
	helper =
	helper = sops
	# Pass owner/repository to the helper for scoped token selection.
	useHttpPath = true

[core]
	editor = nvim
	pager = delta

[delta]
	line-numbers = true
	navigate = true
	side-by-side = true
	zero-style = dim syntax

[diff]
	algorithm = histogram
	colorMoved = default

[fetch]
	prune = true

[gpg]
	format = ssh

[help]
	autocorrect = prompt

[http]
	postBuffer = 157286400

[init]
	defaultBranch = main

[interactive]
	diffFilter = delta --color-only

[merge]
	conflictstyle = zdiff3

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	followTags = true

[rebase]
	autoSquash = true
	updateRefs = true

[rerere]
	enabled = true

[tag]
	gpgSign = true
	sort = version:refname

[user]
	name = Michael Buckley
	email = michaelcbuckley@proton.me
	signingkey = ~/.ssh/signingKey
	useConfigOnly = true

# HTTPS URLs fetch with read-only tokens; normal pushes authenticate over SSH.
[url "git@github.com:"]
	pushInsteadOf = https://github.com/

# Optional machine-local settings when using this file as your user config.
[include]
	path = local.inc
