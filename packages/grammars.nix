# Tree-sitter grammars shared by nvim and helix. Names follow nvim-treesitter;
# helix builds whichever of these its languages.toml also defines.
# Several are missing at time of writing: vimdoc, yang
[
  "bash"
  "diff"
  "go"
  "json"
  "lua"
  "markdown"
  "markdown_inline"
  "nix"
  "nu"
  "python"
  "query"
  "rust"
  "toml"
  "vim"
  "vimdoc"
  "yaml"
  "yang"
]
